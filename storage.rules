rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Single hardcoded admin for v1 — matches lib/admin.ts ADMIN_EMAILS
    // and the same function in firestore.rules. Revisit with a real
    // role/claim system before adding more admins.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "info@judapps.co.uk";
    }

    // Job seeker identity documents. Owner can upload once at signup.
    // Only the owner (briefly, to confirm their own upload succeeded)
    // and the admin can read — never any other user. This mirrors the
    // Firestore verificationSubmissions design: evidence is write-once
    // and tightly scoped, never a general-purpose file store.
    match /verification-ids/{uid}/{fileName} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if false;
    }

    // Employer logos. Public read — shown on job listings anyone can
    // browse. Owner-only write, images only (no PDF, unlike ID docs).
    match /employer-logos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Report evidence images. Owner (the reporter, not the reported
    // user) can upload up to 3 per report at creation time — the count
    // cap itself is enforced in firestore.rules on the report document,
    // not here (Storage rules can't see the sibling Firestore doc). Only
    // the reporter and the admin can ever read — never the reported
    // user, who should never learn what evidence exists against them
    // beyond the report's text reason surfaced through the existing
    // reports flow. Mirrors verification-ids' write-once, tightly scoped
    // design.
    match /report-evidence/{uid}/{fileName} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Default-deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
