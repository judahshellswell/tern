rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Single hardcoded admin for v1 — matches lib/admin.ts ADMIN_EMAILS.
    // Revisit with a real role/claim system before adding more admins.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "info@judapps.co.uk";
    }

    // Waitlist signups are written only by the Admin SDK (server actions),
    // which bypasses these rules entirely. No client path should ever
    // read or write this collection directly.
    match /waitlist/{email} {
      allow read, write: if false;
    }

    // Minimum age enforcement (job seekers only). dateOfBirth is an ISO
    // date string ("2009-04-12"); parse it into a Timestamp and compare
    // against 16 years (5844 days) before now. This is the real gate —
    // the sign-up form's client-side block is UX on top of this, not a
    // substitute for it. Verified against the Firestore rules emulator
    // (exact-boundary cases: 16 today allows, 1 day short denies).
    function meetsMinimumAge(dateOfBirth) {
      return timestamp.date(
        int(dateOfBirth.split('-')[0]),
        int(dateOfBirth.split('-')[1]),
        int(dateOfBirth.split('-')[2])
      ) <= request.time - duration.value(5844, 'd');
    }

    // --- Users ---
    // A user can read and create their own profile. They can update their
    // own details while pending or rejected (edit-and-resubmit resets
    // verificationStatus to "pending" and clears rejectionReason), but can
    // never set their own status to "approved" or "banned", and can never
    // touch their document at all once banned. The admin can read any
    // profile and update verificationStatus + rejectionReason only.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verificationStatus == "pending"
        && (request.resource.data.role != "job_seeker"
          || (meetsMinimumAge(request.resource.data.dateOfBirth)
            && request.resource.data.idDocumentPath is string
            && request.resource.data.idDocumentPath.size() > 0))
        && (request.resource.data.role != "employer"
          || (request.resource.data.logoPath is string
            && request.resource.data.logoPath.size() > 0));
      allow update: if (request.auth != null
          && request.auth.uid == uid
          && resource.data.verificationStatus != "banned"
          && resource.data.verificationStatus != "approved"
          && request.resource.data.verificationStatus == "pending"
          && !("rejectionReason" in request.resource.data)
          && (request.resource.data.role != "job_seeker"
            || (meetsMinimumAge(request.resource.data.dateOfBirth)
              && request.resource.data.idDocumentPath is string
              && request.resource.data.idDocumentPath.size() > 0))
          && (request.resource.data.role != "employer"
            || (request.resource.data.logoPath is string
              && request.resource.data.logoPath.size() > 0)))
        || (request.auth != null
          && request.auth.uid == uid
          && resource.data.verificationStatus != "banned"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["emailVerified"])
          && request.resource.data.emailVerified == true)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["verificationStatus", "rejectionReason"]));
      allow delete: if false;
    }

    function isApprovedEmployer(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "employer"
        && get(/databases/$(database)/documents/users/$(uid)).data.verificationStatus == "approved";
    }

    function isApprovedJobSeeker(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "job_seeker"
        && get(/databases/$(database)/documents/users/$(uid)).data.verificationStatus == "approved";
    }

    // --- Jobs ---
    // Anyone can read published jobs (public browse). Only the owning,
    // approved employer can create or edit their own jobs.
    match /jobs/{jobId} {
      allow read: if resource.data.status == "published"
        || (request.auth != null && request.auth.uid == resource.data.employerId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.employerId
        && isApprovedEmployer(request.auth.uid);
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.employerId)
        || isAdmin();
    }

    // --- Applications ---
    // An approved job seeker can create an application for themself. The
    // applicant can always read their own; the employer can read it only
    // if the applicant isn't currently banned. applicantBanned is
    // denormalized onto the application (set false at creation — only
    // approved, non-banned seekers can apply) rather than checked live via
    // get() — Firestore can only prove a list query safe using fields the
    // query itself filters on, so a cross-document get() keyed off
    // resource.data breaks the employer's applicants list query even when
    // it would otherwise be allowed. Admin can flip it to true — the
    // extension point for a future "ban an already-approved user" action.
    // No such action exists yet (the admin queue only bans pending
    // accounts, which can't have applications), so this field is always
    // false today. Only the employer can update its status.
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && ((request.auth.uid == resource.data.applicantId)
          || (request.auth.uid == resource.data.employerId
            && resource.data.applicantBanned == false));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.applicantId
        && isApprovedJobSeeker(request.auth.uid)
        && request.resource.data.applicantBanned == false;
      allow update: if request.auth != null
        && ((request.auth.uid == resource.data.employerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicantBanned"])));
      allow delete: if false;
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
