rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Single hardcoded admin for v1 — matches lib/admin.ts ADMIN_EMAILS.
    // Revisit with a real role/claim system before adding more admins.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "info@judapps.co.uk";
    }

    // Minimum age enforcement (job seekers only). dateOfBirth is an ISO
    // date string ("2009-04-12"); parse it into a Timestamp and compare
    // against 16 years (5844 days) before now. This is the real gate —
    // the sign-up form's client-side block is UX on top of this, not a
    // substitute for it. Verified against the Firestore rules emulator
    // (exact-boundary cases: 16 today allows, 1 day short denies).
    function meetsMinimumAge(dateOfBirth) {
      return timestamp.date(
        int(dateOfBirth.split('-')[0]),
        int(dateOfBirth.split('-')[1]),
        int(dateOfBirth.split('-')[2])
      ) <= request.time - duration.value(5844, 'd');
    }

    // Jersey's 12 parishes — matches lib/types.ts PARISHES exactly. Kept
    // manually in sync (same convention as isAdmin() vs ADMIN_EMAILS).
    function isValidParish(location) {
      return location in [
        "Grouville", "St. Brelade", "St. Clement", "St. Helier", "St. John",
        "St. Lawrence", "St. Martin", "St. Mary", "St. Ouen", "St. Peter",
        "St. Saviour", "Trinity"
      ];
    }

    // --- Users ---
    // A user can read and create their own profile. They can update their
    // own details while pending or rejected (edit-and-resubmit resets
    // verificationStatus to "pending" and clears rejectionReason), but can
    // never set their own status to "approved", "banned", or "suspended",
    // and can never touch their document at all once banned or suspended.
    // The admin can read any profile and update verificationStatus +
    // rejectionReason only.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verificationStatus == "pending"
        && isValidParish(request.resource.data.location)
        && (request.resource.data.role != "job_seeker"
          || (meetsMinimumAge(request.resource.data.dateOfBirth)
            && request.resource.data.idDocumentPath is string
            && request.resource.data.idDocumentPath.size() > 0
            && (!("preferredJobTypes" in request.resource.data)
              || request.resource.data.preferredJobTypes.size() <= 3)))
        && (request.resource.data.role != "employer"
          || (request.resource.data.logoPath is string
            && request.resource.data.logoPath.size() > 0));
      allow update: if (request.auth != null
          && request.auth.uid == uid
          && resource.data.verificationStatus != "banned"
          && resource.data.verificationStatus != "approved"
          && resource.data.verificationStatus != "suspended"
          && request.resource.data.verificationStatus == "pending"
          && !("rejectionReason" in request.resource.data)
          && isValidParish(request.resource.data.location)
          && (request.resource.data.role != "job_seeker"
            || (meetsMinimumAge(request.resource.data.dateOfBirth)
              && request.resource.data.idDocumentPath is string
              && request.resource.data.idDocumentPath.size() > 0
              && (!("preferredJobTypes" in request.resource.data)
                || request.resource.data.preferredJobTypes.size() <= 3)))
          && (request.resource.data.role != "employer"
            || (request.resource.data.logoPath is string
              && request.resource.data.logoPath.size() > 0)))
        || (request.auth != null
          && request.auth.uid == uid
          && resource.data.verificationStatus != "banned"
          && resource.data.verificationStatus != "suspended"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["emailVerified"])
          && request.resource.data.emailVerified == true)
        // Lightweight self-edit for an already-approved user fixing their
        // own details (name/business name/location/logo) — saves
        // immediately, no re-verification. Deliberately excludes
        // idDocumentPath/dateOfBirth/guardianEmail (job seeker) — those
        // stay reachable only via the reject/resubmit branch above, since
        // re-verifying identity documents outside that flow has real
        // safeguarding weight a simple typo fix shouldn't carry.
        || (request.auth != null && request.auth.uid == uid
          && resource.data.verificationStatus == "approved"
          && request.resource.data.verificationStatus == "approved"
          && isValidParish(request.resource.data.location)
          && ((resource.data.role == "job_seeker"
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "location", "preferredJobTypes"])
                && (!("preferredJobTypes" in request.resource.data)
                  || request.resource.data.preferredJobTypes.size() <= 3))
              || (resource.data.role == "employer"
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["businessName", "registrationNumber", "location", "logoPath"]))))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["verificationStatus", "rejectionReason"]));
      allow delete: if false;
    }

    // Job seeker portfolio entries (self-reported achievements/skills).
    // Self-service CRUD only — the owner can add/edit/delete freely,
    // independent of verificationStatus (unlike the profile doc itself,
    // this isn't locked once approved, since it should stay editable as
    // the seeker builds it up over time). Employer visibility is NOT
    // granted here: Firestore rules can only get()/exists() a single
    // known document path, never run a query, so "does an application
    // exist linking this uid to that employerId" can't be expressed as a
    // rule condition. Employers see this data through a server action
    // (getApplicantProfileForEmployer in app/actions.ts) that queries
    // `applications` via the Admin SDK instead — see that file.
    match /users/{uid}/portfolioEntries/{entryId} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // --- Notifications ---
    // Server-authored only (Admin SDK, via app/actions.ts's
    // writeNotification helper) — a user must never be able to
    // fabricate or backdate their own notifications, so create/delete
    // are fully locked down and only bypassed by the Admin SDK
    // server-side. The owner (or the admin, for their own admin-alert
    // notifications) can read and can flip `read` on an individual
    // doc — nothing else is editable.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
    }

    // --- Readiness gate ---
    // A single fixed-path doc per user — never written directly by the
    // client. Grading must happen atomically with the write (the
    // Anthropic API key is server-only, and a half-graded doc would be a
    // real state to defend against), so every write goes through the
    // submitReadinessGate/reviewReadinessGate server actions
    // (app/actions.ts) via the Admin SDK, which bypasses these rules
    // entirely. This block exists as a defensive boundary — it should
    // never actually be exercised as a real write path.
    match /users/{uid}/readinessGate/submission {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Collection-group queries (the admin readiness-review queue's
    // collectionGroup("readinessGate") query) are matched separately
    // from the direct-path block above — a match on a specific parent
    // path like users/{uid}/readinessGate/submission only ever applies
    // when a client reads that exact path, never for a query that spans
    // every user's subcollection. The recursive {path=**} wildcard is
    // Firestore's documented way to also cover collection-group reads.
    match /{path=**}/readinessGate/{docId} {
      allow list: if isAdmin();
    }

    function isApprovedEmployer(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "employer"
        && get(/databases/$(database)/documents/users/$(uid)).data.verificationStatus == "approved";
    }

    function isApprovedJobSeeker(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "job_seeker"
        && get(/databases/$(database)/documents/users/$(uid)).data.verificationStatus == "approved";
    }

    function hasPassedReadinessGate(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/readinessGate/submission)
        && get(/databases/$(database)/documents/users/$(uid)/readinessGate/submission).data.outcome == "passed";
    }

    // --- Jobs ---
    // Anyone can read published jobs (public browse). Only the owning,
    // approved employer can create or edit their own jobs. Update is
    // restricted to content + status fields only — employerId,
    // employerName, employerLogoUrl, and createdAt can never be changed
    // by the owning employer once created, since the edit form and the
    // close/reopen toggle are both real, reachable client write paths now
    // (not just the create-only form this rule was originally written
    // for), and a modified client could otherwise rewrite ownership,
    // spoof branding, or mess with sort order.
    match /jobs/{jobId} {
      allow read: if resource.data.status == "published"
        || (request.auth != null && request.auth.uid == resource.data.employerId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.employerId
        && isApprovedEmployer(request.auth.uid)
        && isValidParish(request.resource.data.location);
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == resource.data.employerId
          && isValidParish(request.resource.data.location)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["title", "description", "type", "location",
                      "payMode", "payMin", "payMax", "hoursMode",
                      "hoursMin", "hoursMax", "closeDate", "skills",
                      "status"]));
      allow delete: if (request.auth != null && request.auth.uid == resource.data.employerId)
        || isAdmin();
    }

    // --- Applications ---
    // An approved job seeker who has passed their readiness gate
    // (hasPassedReadinessGate — see the readinessGate block above) can
    // create an application for themself. The
    // applicant can always read their own; the employer can read it only
    // if the applicant isn't currently banned or suspended. applicantBanned
    // and applicantSuspended are both denormalized onto the application
    // (set false at creation — only approved, non-banned, non-suspended
    // seekers can apply) rather than checked live via get() — Firestore
    // can only prove a list query safe using fields the query itself
    // filters on, so a cross-document get() keyed off resource.data breaks
    // the employer's applicants list query even when it would otherwise be
    // allowed. Admin can flip either flag — used by banUserAccount and
    // suspendUserAccount/unsuspendUserAccount (app/actions.ts) to cascade
    // onto existing applications so employers stop (or resume) seeing
    // them. Only the employer can update its status.
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && ((request.auth.uid == resource.data.applicantId)
          || (request.auth.uid == resource.data.employerId
            && resource.data.applicantBanned == false
            && resource.data.applicantSuspended == false));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.applicantId
        && isApprovedJobSeeker(request.auth.uid)
        && hasPassedReadinessGate(request.auth.uid)
        && request.resource.data.applicantBanned == false;
      allow update: if request.auth != null
        && ((request.auth.uid == resource.data.employerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "jobStatus"]))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicantBanned", "applicantSuspended"]))
          // The applicant can withdraw their own application — a one-way
          // move to "withdrawn", never any other status, and never from
          // "withdrawn" or "hired" (already terminal; once hired, that's
          // a real-world conversation, not a self-service button). The
          // application document is kept, not deleted, so it stays
          // visible to the employer rather than silently vanishing.
          || (request.auth.uid == resource.data.applicantId
            && resource.data.status != "withdrawn"
            && resource.data.status != "hired"
            && request.resource.data.status == "withdrawn"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])));
      allow delete: if false;
    }

    // --- Reports ---
    // Either role can report the other (job seeker reports an employer,
    // employer reports a job seeker). A report needs a real authenticated
    // reporter, a real reported user, and can't target yourself. The
    // reporter can read back their own reports; only the admin can list
    // all of them or update one (to dismiss it or mark it actioned after
    // banning the reported user via banUserAccount). Reports are a
    // permanent record — never deleted, never rewritten beyond status.
    match /reports/{reportId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.reporterId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterId
        && request.resource.data.reporterId != request.resource.data.reportedId
        && request.resource.data.status == "open"
        && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedId))
        && (!("evidenceImagePaths" in request.resource.data)
          || (request.resource.data.evidenceImagePaths is list
            && request.resource.data.evidenceImagePaths.size() <= 3));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "resolvedAt", "resolvedBy"]);
      allow delete: if false;
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
